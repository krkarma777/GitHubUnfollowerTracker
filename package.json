{
  "name": "github-unfollower",
  "version": "3.0.0",
  "description": "Find out who doesn't follow you back on GitHub and bulk-unfollow them from your terminal. Interactive TUI with whitelist, live progress, and rate-limit-safe pacing.",
  "type": "module",
  "bin": {
    "ghut": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krkarma777/GitHubUnfollowerTracker.git"
  },
  "homepage": "https://github.com/krkarma777/GitHubUnfollowerTracker#readme",
  "bugs": {
    "url": "https://github.com/krkarma777/GitHubUnfollowerTracker/issues"
  },
  "keywords": [
    "github",
    "unfollow",
    "unfollower",
    "unfollowers",
    "bulk-unfollow",
    "mass-unfollow",
    "followers",
    "following",
    "non-mutual",
    "mutual-followers",
    "who-unfollowed-me",
    "follower-tracker",
    "github-api",
    "github-cli",
    "octokit",
    "cli",
    "tui",
    "terminal",
    "ink",
    "whitelist"
  ],
  "author": "krkarma777",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "ink": "^5.0.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
